# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Ваш Telegram user_id (через запятую несколько) — доступ к /stats, /promo_create, /grant
ADMIN_IDS=

# API key for an OpenAI-compatible LLM provider. Empty = deterministic card interpretation mode.
OPENROUTER_API_KEY=

# Alternative to OPENROUTER_API_KEY: absolute path to a UTF-8 text file that
# contains only the LLM provider key. Useful when the key is managed separately.
# For Mistral, leave OPENROUTER_API_KEY empty and keep the key file outside the repo.
LLM_API_KEY_FILE=

# Model and base URL of the OpenAI-compatible endpoint
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional fallback model used when the primary model fails.
# Leave empty to disable provider fallback.
LLM_BACKUP_MODEL=

# Новый ограниченный retry-путь. По умолчанию выключен: включать только после
# прохождения тестов и проверки LLM-телеметрии на staging.
LLM_RETRY_POLICY_V2=false
# Controlled repair допускается только при schema/privacy ошибке второй попытки.
# Включать после сравнения fixed benchmark; требует LLM_RETRY_POLICY_V2=true.
LLM_CONTROLLED_REPAIR_ENABLED=false
LLM_V2_PRIMARY_TIMEOUT_SEC=12
LLM_V2_TOTAL_TIMEOUT_SEC=18
LLM_V2_MAX_ATTEMPTS=2

# Отображаемое имя оракула (менять здесь — бренд нигде больше не зашит)
BOT_DISPLAY_NAME=Мойра

# Бесплатные расклады для новичка / лимит early-bird и бонус.
# Для invite-only beta рекомендовано 10; перед публичным запуском настройте
# лимит по результатам pilot, не меняя код.
FREE_READINGS=10
EARLYBIRD_LIMIT=50
EARLYBIRD_BONUS=3

# Реферальная награда: сколько раскладов получает пригласивший после первого платежа друга
REFERRAL_REWARD=2

# Файл базы (SQLite, создаётся автоматически)
DB_PATH=moira.db

# --- Наблюдаемость (опционально; бот работает и без них) ---
# PostHog Cloud: https://us.posthog.com / https://eu.posthog.com → Project settings → Project API key
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry.io: Settings → Projects → ваш проект → Client Keys (DSN)
SENTRY_DSN=

# Sentry environment label and release identifier. Bind RELEASE_TAG to the
# deployed exact commit SHA so errors map to a reviewed release source.
ENVIRONMENT=production
RELEASE_TAG=dev

# --- Voice question (Deepgram STT, optional) ---
# Off by default. Users can send a <=60-second voice/audio question, edit the
# transcript and then launch the existing reading flow.
DEEPGRAM_STT_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_ENDPOINT=https://api.deepgram.com/v1/listen
DEEPGRAM_STT_MAX_DURATION_SEC=60
DEEPGRAM_STT_MAX_BYTES=10485760
DEEPGRAM_STT_TIMEOUT_SEC=25
